            self.training_data.keys()
        )

        self.label_to_number = {
            label: i
            for i, label in enumerate(self.labels)
        }

        # ----------------------------------------------------
        # Параметры нейросети
        # ----------------------------------------------------

        input_size = len(self.vocabulary)

        hidden_size = 32

        output_size = len(self.labels)

        # ----------------------------------------------------
        # Весовые коэффициенты
        # ----------------------------------------------------

        np.random.seed(42)

        self.W1 = (
            np.random.randn(
                input_size,
                hidden_size
            ) * 0.1
        )

        self.b1 = np.zeros(hidden_size)

        self.W2 = (
            np.random.randn(
                hidden_size,
                output_size
            ) * 0.1
        )

        self.b2 = np.zeros(output_size)

        # ----------------------------------------------------
        # Обучаем сеть
        # ----------------------------------------------------

        self.train()

    # ========================================================
    # ТОКЕНИЗАЦИЯ
    # ========================================================

    def tokenize(self, text):

        text = text.lower()

        words = re.findall(
            r"[а-яёa-z0-9]+",
            text
        )

        return words

    # ========================================================
    # СЛОВАРЬ
    # ========================================================

    def build_vocabulary(self):

        vocabulary = set()

        for examples in self.training_data.values():

            for sentence in examples:

                for word in self.tokenize(sentence):

                    vocabulary.add(word)

        return sorted(vocabulary)

    # ========================================================
    # BAG OF WORDS
    # ========================================================

    def vectorize(self, text):

        words = self.tokenize(text)

        vector = np.zeros(
            len(self.vocabulary),
            dtype=np.float32
        )

        for word in words:

            if word in self.vocabulary:

                index = self.vocabulary.index(word)

                vector[index] = 1.0

        return vector

    # ========================================================
    # SOFTMAX
    # ========================================================

    def softmax(self, x):

        x = x - np.max(x)

        exp = np.exp(x)

        return exp / np.sum(exp)

    # ========================================================
    # FORWARD
    # ========================================================

    def forward(self, x):

        # Первый слой
        z1 = np.dot(
            x,
            self.W1
        ) + self.b1

        # ReLU
        a1 = np.maximum(
            0,
            z1
        )

        # Второй слой
        z2 = np.dot(
            a1,
            self.W2
        ) + self.b2

        # Вероятности
        output = self.softmax(z2)

        return z1, a1, output

    # ========================================================
    # ОБУЧЕНИЕ
    # ========================================================

    def train(self):

        X = []
        Y = []

        for label, examples in self.training_data.items():

            label_number = self.label_to_number[label]

            for sentence in examples:

                X.append(
                    self.vectorize(sentence)
                )

                Y.append(
                    label_number
                )

        X = np.array(X)

        Y = np.array(Y)

        learning_rate = 0.05

        epochs = 1200

        for epoch in range(epochs):

            total_loss = 0

            for x, target in zip(X, Y):

                # ------------------------------
                # Forward
                # ------------------------------

                z1, a1, prediction = self.forward(x)

                # ------------------------------
                # Loss
                # ------------------------------

                probability = max(
                    prediction[target],
                    1e-10
                )

                loss = -np.log(
                    probability
                )

                total_loss += loss

                # ------------------------------
                # Backpropagation
                # ------------------------------

                dz2 = prediction.copy()

                dz2[target] -= 1

                dW2 = np.outer(
                    a1,
                    dz2
                )

                db2 = dz2

                da1 = np.dot(
                    self.W2,
                    dz2
                )

                dz1 = da1 * (
                    z1 > 0
                )

                dW1 = np.outer(
                    x,
                    dz1
                )

                db1 = dz1

                # ------------------------------
                # Gradient descent
                # ------------------------------

                self.W2 -= (
                    learning_rate * dW2
                )

                self.b2 -= (
                    learning_rate * db2
                )

                self.W1 -= (
                    learning_rate * dW1
                )

                self.b1 -= (
                    learning_rate * db1
                )

        print(
            "🧠 Мини-нейросеть обучена."
        )

    # ========================================================
    # ПРЕДСКАЗАНИЕ
    # ========================================================

    def predict(self, text):

        vector = self.vectorize(text)

        # Если вообще нет знакомых слов
        if np.sum(vector) == 0:

            return None, 0.0

        _, _, probabilities = self.forward(
            vector
        )

        index = np.argmax(
            probabilities
        )

        confidence = probabilities[index]

        label = self.labels[index]

        return label, float(confidence)

    # ========================================================
    # ОТВЕТ
    # ========================================================

    def answer(self, text):

        intent, confidence = self.predict(
            text
        )

        # Слишком неуверенный ответ
        if (
            intent is None
            or confidence < 0.60
        ):

            return (
                "Я пока не знаю, как ответить "
                "на этот вопрос. Меня можно обучить "
                "добавив новые примеры."
            )

        # Специальные ответы
        if intent == "time_question":

            now = datetime.datetime.now()

            return (
                f"Сейчас {now.hour} часов "
                f"{now.minute} минут."
            )

        if intent == "date_question":

            today = datetime.datetime.now()

            months = [
                "января",
                "февраля",
                "марта",
                "апреля",
                "мая",
                "июня",
                "июля",
                "августа",
                "сентября",
                "октября",
                "ноября",
                "декабря"
            ]

            return (
                f"Сегодня {today.day} "
                f"{months[today.month - 1]} "
                f"{today.year} года."
            )

        if intent == "goodbye":

            return "До встречи."

        if intent in self.responses:

            responses = self.responses[intent]

            # Берём ответ по очереди
            index = (
                hash(text) %
                len(responses)
            )

            return responses[index]

        return (
            "Я понял вас, "
            "но пока не знаю, что ответить."
        )


# ============================================================
# JARVIS
# ============================================================

class Jarvis:

    def __init__(self):

        # ====================================================
        # НЕЙРОСЕТЬ
        # ====================================================

        print(
            "\n🧠 Загружаю локальную нейросеть..."
        )

        self.ai = MiniNeuralNetwork()

        # ====================================================
        # РАСПОЗНАВАНИЕ РЕЧИ
        # ====================================================

        self.recognizer = sr.Recognizer()

        # ====================================================
        # ГОЛОС
        # ====================================================

        self.engine = pyttsx3.init()

        self.engine.setProperty(
            "rate",
            175
        )

        self.engine.setProperty(
            "volume",
            1.0
        )

        # Ищем русский голос
        voices = self.engine.getProperty(
            "voices"
        )

        for voice in voices:

            voice_data = (
                f"{voice.id} {voice.name}"
            ).lower()

            if (
                "russian" in voice_data
                or "ru-" in voice_data
                or "рус" in voice_data
            ):

                self.engine.setProperty(
                    "voice",
                    voice.id
                )

                print(
                    f"🇷🇺 Русский голос найден: "
                    f"{voice.name}"
                )

                break

        # ====================================================
        # ПАМЯТЬ
        # ====================================================

        self.history = []

    # ========================================================
    # ГОЛОС
    # ========================================================

    def speak(self, text: str):

        print(
            f"\n🤖 JARVIS: {text}"
        )

        try:

            self.engine.say(text)

            self.engine.runAndWait()

        except Exception as error:

            print(
                f"❌ Ошибка синтеза речи: {error}"
            )

    # ========================================================
    # ИИ
    # ========================================================

    def ask_ai(self, command: str):

        try:

            print(
                "\n🧠 Анализирую команду..."
            )

            # Нейросеть
            answer = self.ai.answer(
                command
            )

            # Сохраняем историю
            self.history.append({
                "user": command,
                "assistant": answer
            })

            if len(self.history) > MAX_HISTORY:

                self.history = self.history[
                    -MAX_HISTORY:
                ]

            self.speak(
                answer
            )

        except Exception as error:

            print(
                f"\n❌ Ошибка нейросети: {error}"
            )

            self.speak(
                "Произошла ошибка локальной нейросети."
            )

    # ========================================================
    # ПРОВЕРКА МИКРОФОНА
    # ========================================================

    def show_microphone(self):

        print(
            "\n🎤 Проверяю микрофон..."
        )

        try:

            microphone = sd.query_devices(
                kind="input"
            )

            print(
                f"Микрофон: "
                f"{microphone['name']}"
            )

            print(
                f"Каналов: "
                f"{microphone['max_input_channels']}"
            )

            print(
                "Микрофон найден успешно!\n"
            )

            return True

        except Exception as error:

            print(
                f"❌ Ошибка микрофона: {error}"
            )

            return False

    # ========================================================
    # СЛУШАЕМ
    # ========================================================

    def listen(self):

        print(
            "\n🎙️ Я слушаю..."
        )

        print(
            f"Говори в течение "
            f"{LISTEN_TIME} секунд..."
        )

        filename = None

        try:

            device = sd.query_devices(
                kind="input"
            )

            channels = min(
                device["max_input_channels"],
                1
            )

            if channels < 1:

                print(
                    "❌ У микрофона нет "
                    "входных каналов."
                )

                return ""

            recording = sd.rec(

                int(
                    LISTEN_TIME *
                    SAMPLE_RATE
                ),

                samplerate=SAMPLE_RATE,

                channels=channels,

                dtype="int16"
            )

            sd.wait()

            print(
                "🔊 Запись закончена."
            )

            print(
                "🧠 Распознаю речь..."
            )

            with tempfile.NamedTemporaryFile(
                suffix=".wav",
                delete=False
            ) as temp_file:

                filename = temp_file.name

            wavfile.write(
                filename,
                SAMPLE_RATE,
                recording
            )

            with sr.AudioFile(
                filename
            ) as source:

                audio = (
                    self.recognizer.record(
                        source
                    )
                )

            text = (
                self.recognizer
                .recognize_google(
                    audio,
                    language="ru-RU"
                )
            )

            print(
                f"\n👤 Ты: {text}"
            )

            return text.lower().strip()

        except sr.UnknownValueError:

            print(
                "❓ Я не смог разобрать речь."
            )

            return ""

        except sr.RequestError as error:

            print(
                f"❌ Ошибка сервиса "
                f"распознавания: {error}"
            )

            return ""

        except Exception as error:

            print(
                f"❌ Ошибка микрофона: {error}"
            )

            return ""

        finally:

            if (
                filename
                and os.path.exists(filename)
            ):

                try:

                    os.remove(filename)

                except Exception:

                    pass

    # ========================================================
    # КОМАНДЫ
    # ========================================================

    def execute(self, command: str):

        if not command:

            return True

        # ====================================================
        # ВЫХОД
        # ====================================================

        if any(
            word in command
            for word in [
                "выключись",
                "завершить работу",
                "до свидания",
                "пока"
            ]
        ):

            self.speak(
                "Хорошо. До встречи."
            )

            return False

        # ====================================================
        # ВРЕМЯ
        # ====================================================

        if (
            "который час" in command
            or "сколько времени" in command
        ):

            now = datetime.datetime.now()

            self.speak(
                f"Сейчас "
                f"{now.hour} часов "
                f"{now.minute} минут."
            )

            return True

        # ====================================================
        # ДАТА
        # ====================================================

        if (
            "какое сегодня число"
            in command
            or
            "какая сегодня дата"
            in command
        ):

            today = datetime.datetime.now()

            months = [
                "января",
                "февраля",
                "марта",
                "апреля",
                "мая",
                "июня",
                "июля",
                "августа",
                "сентября",
                "октября",
                "ноября",
                "декабря"
            ]

            self.speak(
                f"Сегодня "
                f"{today.day} "
                f"{months[today.month - 1]} "
                f"{today.year} года."
            )

            return True

        # ====================================================
        # БЛОКНОТ
        # ====================================================

        if "открой блокнот" in command:

            self.speak(
                "Открываю блокнот."
            )

            subprocess.Popen(
                "notepad.exe"
            )

            return True

        # ====================================================
        # КАЛЬКУЛЯТОР
        # ====================================================

        if "открой калькулятор" in command:

            self.speak(
                "Открываю калькулятор."
            )

            subprocess.Popen(
                "calc.exe"
            )

            return True

        # ====================================================
        # ПРОВОДНИК
        # ====================================================

        if "открой проводник" in command:

            self.speak(
                "Открываю проводник."
            )

            subprocess.Popen(
                "explorer.exe"
            )

            return True

        # ====================================================
        # БРАУЗЕР
        # ====================================================

        if "открой браузер" in command:

            self.speak(
                "Открываю браузер."
            )

            webbrowser.open(
                "https://www.google.com"
            )

            return True

        # ====================================================
        # YOUTUBE
        # ====================================================

        if (
            "открой ютуб" in command
            or
            "открой youtube" in command
        ):

            self.speak(
                "Открываю YouTube."
            )

            webbrowser.open(
                "https://www.youtube.com"
            )

            return True

        # ====================================================
        # ПОИСК GOOGLE
        # ====================================================

        if command.startswith("найди "):

            query = command[
                len("найди "):
            ].strip()

            if query:

                self.speak(
                    f"Ищу {query}."
                )

                url = (
                    "https://www.google.com/search?q="
                    +
                    urllib.parse.quote(
                        query
                    )
                )

                webbrowser.open(
                    url
                )

            return True

        # ====================================================
        # ПОИСК YOUTUBE
        # ====================================================

        if command.startswith("включи "):

            query = command[
                len("включи "):
            ].strip()

            if query:

                self.speak(
                    f"Ищу {query} "
                    f"на YouTube."
                )

                url = (
                    "https://www.youtube.com/results?search_query="
                    +
                    urllib.parse.quote(
                        query
                    )
                )

                webbrowser.open(
                    url
                )

            return True

        # ====================================================
        # ПРИВЕТСТВИЕ
        # ====================================================

        if any(
            word in command
            for word in [
                "привет",
                "добрый день",
                "доброе утро",
                "добрый вечер"
            ]
        ):

            self.speak(
                "Здравствуйте. "
                "Я готов к работе."
            )

            return True

        # ====================================================
        # КТО ТЫ
        # ====================================================

        if "кто ты" in command:

            self.speak(
                "Я Джарвис, ваш "
                "локальный голосовой помощник "
                "с небольшой нейронной сетью."
            )

            return True

        # ====================================================
        # НЕЙРОСЕТЬ
        # ====================================================

        self.ask_ai(
            command
        )

        return True

    # ========================================================
    # ЗАПУСК
    # ========================================================

    def run(self):

        if not self.show_microphone():

            self.speak(
                "Я не вижу микрофон."
            )

            return

        self.speak(
            "Система запущена. "
            "Локальная нейросеть готова."
        )

        while True:

            command = self.listen()

            if not command:

                continue

            # ------------------------------------------------
            # Проверяем обращение
            # ------------------------------------------------

            if JARVIS_NAME not in command:

                print(
                    "Фраза без обращения "
                    "к Джарвису. Игнорирую."
                )

                continue

            # Удаляем "джарвис"
            command = command.replace(
                JARVIS_NAME,
                "",
                1
            ).strip()

            # ------------------------------------------------
            # Просто "Джарвис"
            # ------------------------------------------------

            if not command:

                self.speak(
                    "Да, я слушаю."
                )

                continue

            # ------------------------------------------------
            # Выполняем
            # ------------------------------------------------

            if not self.execute(
                command
