            word: index
            for index, word in enumerate(
                self.vocabulary
            )
        }

        self.labels = list(
            self.training_data.keys()
        )

        self.label_to_number = {
            label: i
            for i, label in enumerate(self.labels)
        }

        # =====================================================
        # ПАРАМЕТРЫ СЕТИ
        # =====================================================

        input_size = len(self.vocabulary)

        hidden_size = 64

        output_size = len(self.labels)

        rng = np.random.default_rng(
            RANDOM_SEED
        )

        self.W1 = (
            rng.standard_normal(
                (input_size, hidden_size)
            ).astype(np.float32)
            * 0.08
        )

        self.b1 = np.zeros(
            hidden_size,
            dtype=np.float32
        )

        self.W2 = (
            rng.standard_normal(
                (hidden_size, output_size)
            ).astype(np.float32)
            * 0.08
        )

        self.b2 = np.zeros(
            output_size,
            dtype=np.float32
        )

        # =====================================================
        # ОБУЧЕНИЕ
        # =====================================================

        self.train()

    # ========================================================
    # СЛОВАРЬ
    # ========================================================

    def build_vocabulary(self):

        vocabulary = set()

        for examples in self.training_data.values():

            for sentence in examples:

                for feature in make_features(sentence):

                    vocabulary.add(feature)

        return sorted(vocabulary)

    # ========================================================
    # ВЕКТОРИЗАЦИЯ
    # ========================================================

    def vectorize(self, text):

        features = make_features(text)

        vector = np.zeros(
            len(self.vocabulary),
            dtype=np.float32
        )

        for feature in features:

            index = self.word_to_index.get(
                feature
            )

            if index is not None:

                vector[index] += 1.0

        # Нормализация
        if np.sum(vector) > 0:

            vector /= np.sum(vector)

        return vector

    # ========================================================
    # SOFTMAX
    # ========================================================

    def softmax(self, x):

        x = x - np.max(x)

        exp = np.exp(x)

        return exp / (
            np.sum(exp) + 1e-9
        )

    # ========================================================
    # RELU
    # ========================================================

    def relu(self, x):

        return np.maximum(
            0,
            x
        )

    # ========================================================
    # FORWARD
    # ========================================================

    def forward(self, x):

        z1 = (
            np.dot(
                x,
                self.W1
            )
            + self.b1
        )

        a1 = self.relu(
            z1
        )

        z2 = (
            np.dot(
                a1,
                self.W2
            )
            + self.b2
        )

        output = self.softmax(
            z2
        )

        return (
            z1,
            a1,
            output
        )

    # ========================================================
    # ОБУЧЕНИЕ
    # ========================================================

    def train(self):

        X = []
        Y = []

        for label, examples in self.training_data.items():

            target = self.label_to_number[
                label
            ]

            for sentence in examples:

                X.append(
                    self.vectorize(
                        sentence
                    )
                )

                Y.append(
                    target
                )

        X = np.array(
            X,
            dtype=np.float32
        )

        Y = np.array(
            Y,
            dtype=np.int32
        )

        learning_rate = 0.045

        epochs = 900

        for epoch in range(
            epochs
        ):

            # Перемешиваем данные
            indexes = np.random.permutation(
                len(X)
            )

            for index in indexes:

                x = X[index]

                target = Y[index]

                z1, a1, prediction = (
                    self.forward(x)
                )

                # ----------------------------
                # OUTPUT
                # ----------------------------

                dz2 = prediction.copy()

                dz2[target] -= 1.0

                dW2 = np.outer(
                    a1,
                    dz2
                )

                db2 = dz2

                # ----------------------------
                # HIDDEN
                # ----------------------------

                da1 = np.dot(
                    self.W2,
                    dz2
                )

                dz1 = (
                    da1
                    * (z1 > 0)
                )

                dW1 = np.outer(
                    x,
                    dz1
                )

                db1 = dz1

                # ----------------------------
                # UPDATE
                # ----------------------------

                self.W2 -= (
                    learning_rate
                    * dW2
                )

                self.b2 -= (
                    learning_rate
                    * db2
                )

                self.W1 -= (
                    learning_rate
                    * dW1
                )

                self.b1 -= (
                    learning_rate
                    * db1
                )

        print(
            f"🧠 Нейросеть обучена. "
            f"Интентов: {len(self.labels)}"
        )

        print(
            f"📚 Словарь: "
            f"{len(self.vocabulary)} признаков"
        )

    # ========================================================
    # ПРЕДСКАЗАНИЕ
    # ========================================================

    def predict(self, text):

        vector = self.vectorize(
            text
        )

        if np.sum(vector) <= 0:

            return None, 0.0

        _, _, probabilities = (
            self.forward(
                vector
            )
        )

        index = int(
            np.argmax(
                probabilities
            )
        )

        confidence = float(
            probabilities[index]
        )

        label = self.labels[
            index
        ]

        return (
            label,
            confidence
        )

    # ========================================================
    # ОТВЕТ
    # ========================================================

    def answer(
        self,
        text,
        history=None
    ):

        intent, confidence = (
            self.predict(text)
        )

        print(
            f"🧠 Intent: {intent}"
        )

        print(
            f"📊 Уверенность: "
            f"{confidence:.2f}"
        )

        if (
            intent is None
            or confidence < CONFIDENCE_THRESHOLD
        ):

            return (
                "Я пока не уверен, "
                "что правильно понял тебя. "
                "Попробуй сформулировать немного иначе."
            )

        # ====================================================
        # ВРЕМЯ
        # ====================================================

        if intent == "time_question":

            now = datetime.datetime.now()

            return (
                f"Сейчас "
                f"{now.hour} часов "
                f"{now.minute} минут."
            )

        # ====================================================
        # ДАТА
        # ====================================================

        if intent == "date_question":

            today = datetime.datetime.now()

            months = [
                "января",
                "февраля",
                "марта",
                "апреля",
                "мая",
                "июня",
                "июля",
                "августа",
                "сентября",
                "октября",
                "ноября",
                "декабря"
            ]

            return (
                f"Сегодня "
                f"{today.day} "
                f"{months[today.month - 1]} "
                f"{today.year} года."
            )

        # ====================================================
        # ДЕНЬ НЕДЕЛИ
        # ====================================================

        if intent == "current_day":

            days = [
                "понедельник",
                "вторник",
                "среда",
                "четверг",
                "пятница",
                "суббота",
                "воскресенье"
            ]

            today = datetime.datetime.now()

            return (
                f"Сегодня "
                f"{days[today.weekday()]}."
            )

        # ====================================================
        # ПРОЩАНИЕ
        # ====================================================

        if intent == "goodbye":

            return "До встречи."

        # ====================================================
        # ОТВЕТ ИЗ СПИСКА
        # ====================================================

        if intent in self.responses:

            responses = (
                self.responses[
                    intent
                ]
            )

            return random.choice(
                responses
            )

        return (
            "Я понял тебя, "
            "но пока не знаю, "
            "что лучше ответить."
        )


# ============================================================
# JARVIS
# ============================================================

class Jarvis:

    def __init__(self):

        # ====================================================
        # НЕЙРОСЕТЬ
        # ====================================================

        self.ai = MiniNeuralNetwork()

        # ====================================================
        # РАСПОЗНАВАНИЕ
        # ====================================================

        self.recognizer = sr.Recognizer()

        # ====================================================
        # ГОЛОС
        # ====================================================

        print(
            "\n🔊 Загружаю голосовой движок..."
        )

        self.voice_rate = 175
        self.voice_volume = 1.0
        self.voice_id = None

        self._setup_voice()

        # ====================================================
        # ПАМЯТЬ
        # ====================================================

        self.history = []

        # ====================================================
        # РЕЖИМ РАЗГОВОРА
        # ====================================================

        self.conversation_mode = False

    # ========================================================
    # ГОВОРИМ
    # ========================================================

    def _setup_voice(self):
        """
        Инициализирует pyttsx3 через SAPI5 и выбирает русский голос.
        Каждый вызов speak() создаёт отдельный короткоживущий engine,
        чтобы избежать проблем с очередью/состоянием SAPI5.
        """
        try:
            test_engine = pyttsx3.init("sapi5")

            test_engine.setProperty(
                "rate",
                self.voice_rate
            )

            test_engine.setProperty(
                "volume",
                self.voice_volume
            )

            voices = test_engine.getProperty("voices") or []

            print(
                f"🔊 Найдено голосов Windows: {len(voices)}"
            )

            russian_voice = None

            for voice in voices:
                info = " ".join(
                    [
                        str(getattr(voice, "id", "")),
                        str(getattr(voice, "name", "")),
                        str(getattr(voice, "languages", "")),
                    ]
                ).lower()

                if (
                    "russian" in info
                    or "ru-ru" in info
                    or "ru_ru" in info
                    or "ru_" in info
                    or "рус" in info
                ):
                    russian_voice = voice
                    break

            if russian_voice is not None:
                self.voice_id = russian_voice.id

                print(
                    f"🇷🇺 Русский голос: "
                    f"{getattr(russian_voice, 'name', russian_voice.id)}"
                )

            elif voices:
                self.voice_id = voices[0].id

                print(
                    "⚠️ Русский голос не найден. "
                    f"Использую: {getattr(voices[0], 'name', voices[0].id)}"
                )

            else:
                self.voice_id = None
                print("❌ Windows не вернул список голосов.")

            # Закрываем только тестовый engine.
            try:
                test_engine.stop()
            except Exception:
                pass

            print("✅ Голосовой движок pyttsx3 готов.")
            return True

        except Exception as error:
            self.voice_id = None

            print(
                f"❌ Ошибка запуска pyttsx3/SAPI5: {error}"
            )

            return False

    def speak(self, text: str):
        """
        Озвучивает ответ через pyttsx3 + SAPI5.

        Важное отличие:
        новый engine создаётся на каждый ответ.
        Это устраняет ситуации, когда предыдущая очередь
        pyttsx3/SAPI5 остаётся в некорректном состоянии.
        """
        text = str(text).strip()

        if not text:
            return False

        print(
            f"\n🤖 JARVIS: {text}"
        )

        engine = None

        try:
            engine = pyttsx3.init("sapi5")

            engine.setProperty(
                "rate",
                self.voice_rate
            )

            engine.setProperty(
                "volume",
                self.voice_volume
            )

            if self.voice_id:
                engine.setProperty(
                    "voice",
                    self.voice_id
                )

            started = {"value": False}
            finished = {"value": False}

            def on_start(name):
                started["value"] = True
                print("🔊 SAPI5 начал озвучивание.")

            def on_end(name, completed):
                finished["value"] = bool(completed)
                print(
                    f"🔊 SAPI5 завершил озвучивание: "
                    f"{completed}"
                )

            try:
                engine.connect(
                    "started-utterance",
                    on_start
                )

                engine.connect(
                    "finished-utterance",
                    on_end
                )
            except Exception:
                pass

            engine.say(text)
            engine.runAndWait()

            if not started["value"]:
                print(
                    "⚠️ pyttsx3 не сообщил о начале озвучивания."
                )

            elif finished["value"]:
                print("✅ Ответ действительно обработан SAPI5.")

            else:
                print(
                    "⚠️ SAPI5 завершил обработку без подтверждения."
                )

            return True

        except Exception as error:
            print(
                f"❌ Ошибка pyttsx3/SAPI5: {error}"
            )
            return False

        finally:
            if engine is not None:
                try:
                    engine.stop()
                except Exception:
                    pass

    def test_voice(self):
        """
        Отдельная проверка голосового движка.
        """
        print(
            "\n🔊 Тестирую голосовой ответ..."
        )

        return self.speak(
            "Проверка. Если вы слышите этот текст, голосовой ответ работает."
        )

    def remember(
        self,
        user_text,
        assistant_text
    ):

        self.history.append({

            "user": user_text,

            "assistant": assistant_text

        })

        if (
            len(self.history)
            > MAX_HISTORY
        ):

            self.history = (
                self.history[
                    -MAX_HISTORY:
                ]
            )

    # ========================================================
    # AI
    # ========================================================

    def ask_ai(
        self,
        command
    ):

        try:

            answer = self.ai.answer(
                command,
                self.history
            )

            self.remember(
                command,
                answer
            )

            self.speak(
                answer
            )

        except Exception as error:

            print(
                f"❌ Ошибка нейросети: "
                f"{error}"
            )

            self.speak(
                "Произошла ошибка локальной нейросети."
            )

    # ========================================================
    # МИКРОФОН
    # ========================================================

    def show_microphone(self):

        print(
            "\n🎤 Проверяю микрофон..."
        )

        try:

            microphone = (
                sd.query_devices(
                    kind="input"
                )
            )

            print(
                f"Микрофон: "
                f"{microphone['name']}"
            )

            print(
                f"Каналов: "
                f"{microphone['max_input_channels']}"
            )

            return True

        except Exception as error:

            print(
                f"❌ Ошибка микрофона: "
                f"{error}"
            )

            return False

    # ========================================================
    # СЛУШАЕМ
    # ========================================================

    def listen(self):

        print(
            "\n🎙️ Я слушаю..."
        )

        print(
            f"Говори в течение "
            f"{LISTEN_TIME} секунд..."
        )

        filename = None

        try:

            device = (
                sd.query_devices(
                    kind="input"
                )
            )

            channels = min(
                int(
                    device[
                        "max_input_channels"
                    ]
                ),
                1
            )

            if channels < 1:

                print(
                    "❌ Нет входного канала."
                )

                return ""

            recording = sd.rec(

                int(
                    LISTEN_TIME
                    * SAMPLE_RATE
                ),

                samplerate=SAMPLE_RATE,

                channels=channels,

                dtype="int16"
            )

            sd.wait()

            print(
                "🔊 Запись закончена."
            )

            print(
                "🧠 Распознаю речь..."
            )

            with tempfile.NamedTemporaryFile(
                suffix=".wav",
                delete=False
            ) as temp_file:

                filename = (
                    temp_file.name
                )

            wavfile.write(
                filename,
                SAMPLE_RATE,
                recording
            )

            with sr.AudioFile(
                filename
            ) as source:

                audio = (
                    self.recognizer.record(
                        source
                    )
                )

            text = (
                self.recognizer
                .recognize_google(
                    audio,
                    language="ru-RU"
                )
            )

            print(
                f"\n👤 Ты: {text}"
            )

            return normalize_text(
                text
            )

        except sr.UnknownValueError:

            print(
                "❓ Я не смог разобрать речь."
            )

            return ""

        except sr.RequestError as error:

            print(
                f"❌ Ошибка сервиса "
                f"распознавания: {error}"
            )

            return ""

        except Exception as error:

            print(
                f"❌ Ошибка микрофона: "
                f"{error}"
            )

            return ""

        finally:

            if (
                filename
                and os.path.exists(
                    filename
                )
            ):

                try:

                    os.remove(
                        filename
                    )

                except Exception:

                    pass

    # ========================================================
    # ОТКРЫТИЕ URL
    # ========================================================

    def open_url(
        self,
        url
    ):

        try:

            opened = webbrowser.open(url)

            if opened:
                return True

            return False

        except Exception as error:

            print(
                f"❌ Ошибка браузера: "
                f"{error}"
            )

            return False

    # ========================================================
    # GOOGLE ПОИСК
    # ========================================================

    def google_search(
        self,
        query
    ):

        query = query.strip()

        if not query:

            self.speak(
                "Я не понял, что именно нужно найти."
            )

            return False

        url = (
            "https://www.google.com/search?q="
            + urllib.parse.quote(query)
        )

        if self.open_url(url):

            self.speak(
                f"Поиск {query} выполнен."
            )

            return True

        self.speak(
            f"Не удалось выполнить поиск {query}."
        )

        return False

    # ========================================================
    # YOUTUBE ПОИСК
    # ========================================================

    def youtube_search(
        self,
        query
    ):

        query = query.strip()

        if not query:

            self.speak(
                "Я не понял, что нужно найти на YouTube."
            )

            return False

        url = (
            "https://www.youtube.com/results?search_query="
            + urllib.parse.quote(query)
        )

        if self.open_url(url):

            self.speak(
                f"Поиск {query} на YouTube выполнен."
            )

            return True

        self.speak(
            f"Не удалось выполнить поиск {query} на YouTube."
        )

        return False

    # ========================================================
    # ИЗВЛЕЧЕНИЕ ПОИСКА
    # ========================================================

    def extract_search_query(
        self,
        command
    ):

        prefixes = [
            "найди ",
            "поищи ",
            "загугли ",
            "найди в интернете ",
            "поищи в интернете ",
            "посмотри в интернете "
        ]

        for prefix in prefixes:

            if command.startswith(
                prefix
            ):

                return (
                    command[
                        len(prefix):
                    ].strip()
                )

        return ""

    # ========================================================
    # YOUTUBE QUERY
    # ========================================================

    def extract_youtube_query(
        self,
        command
    ):

        prefixes = [
            "включи ",
            "найди видео ",
            "найди музыку ",
            "найди на ютубе ",
            "поищи на ютубе ",
            "поищи видео на ютубе ",
            "поищи музыку на ютубе "
        ]

        for prefix in prefixes:

            if command.startswith(
                prefix
            ):

                return (
                    command[
                        len(prefix):
                    ].strip()
                )

        return ""

    # ========================================================
    # КАЛЬКУЛЯТОР
    # ========================================================

    def calculate(
        self,
        command
    ):

        expression = command

        replacements = {

            "плюс": "+",
            "минус": "-",
            "умножить на": "*",
            "умножить": "*",
            "разделить на": "/",
            "разделить": "/",

            "x": "*",
            "икс": "*",

            "равно": ""
        }

        for word, symbol in (
            replacements.items()
        ):

            expression = expression.replace(
                word,
                symbol
            )

        expression = re.sub(
            r"[^0-9+\-*/(). ]",
            "",
            expression
        )

        expression = expression.strip()

        if not expression:

            self.speak(
                "Я не смог понять пример."
            )

            return False

        try:

            result = eval(
                expression,
                {
                    "__builtins__": {}
                },
                {}
            )

            self.speak(
                f"Результат — {result}."
            )

            return True

        except Exception:

            self.speak(
                "Я не смог вычислить этот пример."
            )

            return False

    # ========================================================
    # ПОГОДА
    # ========================================================

    def weather(
        self
    ):

        url = (
            "https://www.google.com/search?q="
            + urllib.parse.quote("погода сегодня")
        )

        if self.open_url(url):

            self.speak(
                "Информация о погоде открыта."
            )

            return True

        self.speak(
            "Не удалось открыть информацию о погоде."
        )

        return False

    # ========================================================
    # ВЫПОЛНЕНИЕ КОМАНД
    # ========================================================

    def execute(
        self,
        command
    ):

        if not command:

            return True

        command = normalize_text(
            command
        )

        # ====================================================
        # НАЧАЛО РАЗГОВОРА
        # ====================================================

        if (
            "давай поговорим"
            in command
            or
            "давай общаться"
            in command
            or
            "поговори со мной"
            in command
            or
            "начни разговор"
            in command
            or
            "хочу поговорить"
            in command
        ):

            self.conversation_mode = True

            self.speak(
                "Конечно. Я готов поговорить. "
                "Теперь можешь говорить без слова Джарвис."
            )

            return True

        # ====================================================
        # КОНЕЦ РАЗГОВОРА
        # ====================================================

        if (
            self.conversation_mode
            and
            (
                "закончи разговор"
                in command
                or
                "заверши разговор"
                in command
                or
                "хватит разговора"
                in command
                or
                command in [
                    "все",
                    "до свидания",
                    "пока"
                ]
            )
        ):

            self.conversation_mode = False

            self.speak(
                "Хорошо. Режим разговора завершён."
            )

            return True

        # ====================================================
        # ВЫКЛЮЧЕНИЕ
        # ====================================================

        # ====================================================
        # ЗАВЕРШЕНИЕ РАБОТЫ JARVIS
        # ====================================================

        shutdown_phrases = [
            "выключись",
            "выключи себя",
            "выключи джарвиса",
            "заверши работу",
            "заверши программу",
            "завершение работы",
            "завершение работ",
            "завершении работы",
            "завершении работ",
            "закончи работу",
            "закончить работу",
            "закройся",
            "закрой джарвиса",
            "закрой программу",
            "останови работу",
            "останови джарвиса"
        ]

        # Обычные точные фразы
        if any(
            phrase in command
            for phrase in shutdown_phrases
        ):
            self.speak(
                "Завершаю работу программы. До встречи."
            )
            return False

        # Если распознавание немного изменило окончание слова,
        # например: "завершении работ" вместо "завершение работы".
        if (
            "заверш" in command
            and "работ" in command
        ):
            self.speak(
                "Завершаю работу программы. До встречи."
            )
            return False

        # Если нейросеть уверенно определила shutdown,
        # тоже завершаем программу.
        predicted_intent, predicted_confidence = self.ai.predict(command)

        if (
            predicted_intent == "shutdown"
            and predicted_confidence >= CONFIDENCE_THRESHOLD
        ):
            self.speak(
                "Завершаю работу программы. До встречи."
            )
            return False

        # ====================================================
        # ВРЕМЯ
        # ====================================================

        if (
            "который час"
            in command
            or
            "сколько времени"
            in command
            or
            command == "время"
        ):

            now = (
                datetime.datetime.now()
            )

            self.speak(
                f"Сейчас "
                f"{now.hour} часов "
                f"{now.minute} минут."
            )

            return True

        # ====================================================
        # ДАТА
        # ====================================================

        if (
            "какая сегодня дата"
            in command
            or
            "какое сегодня число"
            in command
        ):

            today = (
                datetime.datetime.now()
            )

            months = [
                "января",
                "февраля",
                "марта",
                "апреля",
                "мая",
                "июня",
                "июля",
                "августа",
                "сентября",
                "октября",
                "ноября",
                "декабря"
            ]

            self.speak(
                f"Сегодня "
                f"{today.day} "
                f"{months[today.month - 1]} "
                f"{today.year} года."
            )

            return True

        # ====================================================
        # ДЕНЬ НЕДЕЛИ
        # ====================================================

        if (
            "день недели"
            in command
            or
            "какой сегодня день"
            in command
        ):

            days = [
                "понедельник",
                "вторник",
                "среда",
                "четверг",
                "пятница",
                "суббота",
                "воскресенье"
            ]

            day = (
                datetime.datetime
                .now()
                .weekday()
            )

            self.speak(
                f"Сегодня {days[day]}."
            )

            return True

        # ====================================================
        # БЛОКНОТ
        # ====================================================

        if (
            "блокнот"
            in command
        ):

            try:

                subprocess.Popen("notepad.exe")

                self.speak(
                    "Блокнот успешно запущен."
                )

            except Exception as error:

                self.speak(
                    "Не удалось запустить блокнот."
                )

                print(f"❌ Ошибка блокнота: {error}")

            return True

        # ====================================================
        # КАЛЬКУЛЯТОР
        # ====================================================

        if (
            "калькулятор"
            in command
        ):

            try:

                subprocess.Popen("calc.exe")

                self.speak(
                    "Калькулятор успешно запущен."
                )

            except Exception as error:

                self.speak(
                    "Не удалось запустить калькулятор."
                )

                print(f"❌ Ошибка калькулятора: {error}")

            return True

        # ====================================================
        # ПРОВОДНИК
        # ====================================================

        if (
            "открой проводник"
            in command
            or
            "запусти проводник"
            in command
            or
            "открой файлы"
            in command
            or
            "открой папки"
            in command
        ):

            try:

                subprocess.Popen("explorer.exe")

                self.speak(
                    "Проводник успешно запущен."
                )

            except Exception as error:

                self.speak(
                    "Не удалось запустить проводник."
                )

                print(f"❌ Ошибка проводника: {error}")

            return True

        # ====================================================
        # ЗАГРУЗКИ
        # ====================================================

        if (
            "открой загрузки"
            in command
            or
            "покажи загрузки"
            in command
            or
            "открой папку загрузки"
            in command
        ):

            downloads = os.path.join(
                os.path.expanduser("~"),
                "Downloads"
            )

            try:

                os.startfile(downloads)

                self.speak(
                    "Папка загрузок успешно открыта."
                )

            except Exception as error:

                self.speak(
                    "Не удалось открыть папку загрузок."
                )

                print(f"❌ Ошибка загрузок: {error}")

            return True

        # ====================================================
        # ДИСПЕТЧЕР ЗАДАЧ
        # ====================================================

        if (
            "диспетчер задач"
            in command
            or
            "task manager"
            in command
        ):

            try:

                subprocess.Popen("taskmgr.exe")

                self.speak(
                    "Диспетчер задач успешно запущен."
                )

            except Exception as error:

                self.speak(
                    "Не удалось запустить диспетчер задач."
                )

                print(f"❌ Ошибка диспетчера задач: {error}")

            return True

        # ====================================================
        # CMD
        # ====================================================

        if (
            "командную строку"
            in command
            or
            command == "открой cmd"
            or
            command == "запусти cmd"
            or
            "открой консоль"
            in command
        ):

            try:

                subprocess.Popen("cmd.exe")

                self.speak(
                    "Командная строка успешно запущена."
                )

            except Exception as error:

                self.speak(
                    "Не удалось запустить командную строку."
                )

                print(f"❌ Ошибка CMD: {error}")

            return True

        # ====================================================
        # НАСТРОЙКИ
        # ====================================================

        if (
            "открой настройки"
            in command
            or
            "запусти настройки"
            in command
            or
            "покажи настройки"
            in command
        ):

            try:

                subprocess.Popen(
                    "start ms-settings:",
                    shell=True
                )

                self.speak(
                    "Настройки Windows успешно открыты."
                )

            except Exception as error:

                self.speak(
                    "Не удалось открыть настройки Windows."
                )

                print(f"❌ Ошибка настроек: {error}")

            return True

        # ====================================================
        # БРАУЗЕР
        # ====================================================

        if (
            "открой браузер"
            in command
            or
            "открой интернет"
            in command
            or
            "открой google"
            in command
            or
            "открой гугл"
            in command
        ):

            if self.open_url(
                "https://www.google.com"
            ):

                self.speak(
                    "Браузер успешно открыт."
                )

            else:

                self.speak(
                    "Не удалось открыть браузер."
                )

            return True

        # ====================================================
        # YOUTUBE
        # ====================================================

        if (
            "открой ютуб"
            in command
            or
            "открой youtube"
            in command
            or
            "запусти ютуб"
            in command
        ):

            if self.open_url(
                "https://www.youtube.com"
            ):

                self.speak(
                    "YouTube успешно открыт."
                )

            else:

                self.speak(
                    "Не удалось открыть YouTube."
                )

            return True

        # ====================================================
        # ПОГОДА
        # ====================================================

        if (
            "какая погода"
            in command
            or
            "погода сегодня"
            in command
            or
            "что с погодой"
            in command
        ):

            self.weather()

            return True

        # ====================================================
        # GOOGLE ПОИСК
        # ====================================================

        search_prefixes = [
            "найди ",
            "поищи ",
            "загугли ",
            "найди в интернете ",
            "поищи в интернете "
        ]

        if any(
            command.startswith(
                prefix
            )
            for prefix in search_prefixes
        ):

            query = (
                self.extract_search_query(
                    command
                )
            )

            self.google_search(
                query
            )

            return True

        # ====================================================
        # YOUTUBE ПОИСК
        # ====================================================

        youtube_prefixes = [
            "включи ",
            "найди видео ",
            "найди музыку ",
            "найди на ютубе ",
            "поищи на ютубе ",
            "поищи видео на ютубе ",
            "поищи музыку на ютубе "
        ]

        if any(
            command.startswith(
                prefix
            )
            for prefix in youtube_prefixes
        ):

            query = (
                self.extract_youtube_query(
                    command
                )
            )

            self.youtube_search(
                query
            )

            return True

        # ====================================================
        # ПРИВЕТСТВИЕ
        # ====================================================

        if any(
            word in command
            for word in [
                "привет",
                "здравствуй",
                "добрый день",
                "доброе утро",
                "добрый вечер"
            ]
        ):

            self.speak(
                "Приветствую. Я готов к работе."
            )

            return True

        # ====================================================
        # КТО ТЫ
        # ====================================================

        if (
            "кто ты"
            in command
            or
            "как тебя зовут"
            in command
        ):

            self.speak(
                "Я Джарвис, локальный "
                "голосовой помощник с "
                "небольшой нейросетью."
            )

            return True

        # ====================================================
        # ПОСЧИТАТЬ
        # ====================================================

        if (
            command.startswith(
                "посчитай"
            )
            or
            command.startswith(
                "вычисли"
            )
            or
            "сколько будет"
            in command
        ):

            self.calculate(
                command
            )

            return True

        # ====================================================
        # НЕРВОСЕТЬ
        # ====================================================

        self.ask_ai(
            command
        )

        return True

    # ========================================================
    # ЗАПУСК
    # ========================================================

    def run(self):
        # 🔊 Проверяем голос до запуска основного цикла.
        voice_ok = self.test_voice()
        if not voice_ok:
            print("⚠️ JARVIS продолжит работу, но голос может быть недоступен.")
        else:
            print("✅ Голосовая система готова.")
            self.speak("Голосовая система работает нормально.")


        if not self.show_microphone():

            self.speak(
                "Я не вижу микрофон."
            )

            return

        self.speak(
            "Система запущена. "
            "Улучшенная локальная нейросеть готова."
        )

        while True:

            command = self.listen()

            if not command:

                continue

            # =================================================
            # РЕЖИМ РАЗГОВОРА
            # =================================================

            if self.conversation_mode:

                print(
                    "\n💬 Режим разговора активен."
                )

                if not self.execute(
                    command
                ):

                    break

                continue

            # =================================================
            # ОБЫЧНЫЙ РЕЖИМ
            # =================================================

            if (
                JARVIS_NAME
                not in command
            ):

                print(
                    "Фраза без обращения "
                    "к Джарвису. Игнорирую."
                )

                continue

            # =================================================
            # УДАЛЯЕМ ИМЯ
            # =================================================

            command = command.replace(
                JARVIS_NAME,
                "",
                1
            ).strip()

            # =================================================
            # ПРОСТО «ДЖАРВИС»
            # =================================================

            if not command:

                self.speak(
                    "Да, я слушаю."
                )

                continue

            # =================================================
            # ВЫПОЛНЯЕМ
            # =================================================

            if not self.execute(
                command
            ):

                break


# ============================================================
# MAIN
# ============================================================

if __name__ == "__main__":

    try:

        jarvis = Jarvis()

        jarvis.run()

    except KeyboardInterrupt:

        print(
            "\n\n🛑 JARVIS остановлен."
        )

    except Exception as error:

        print(
            "\n❌ Критическая ошибка:"
        )

        print(
            error
        )
