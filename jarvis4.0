        self.vocabulary = self.build_vocabulary()

        self.word_to_index = {
            word: index
            for index, word in enumerate(
                self.vocabulary
            )
        }

        self.labels = list(
            self.training_data.keys()
        )

        self.label_to_number = {
            label: i
            for i, label in enumerate(self.labels)
        }

        input_size = len(self.vocabulary)

        hidden_size = 64

        output_size = len(self.labels)

        rng = np.random.default_rng(
            RANDOM_SEED
        )

        self.W1 = (
            rng.standard_normal(
                (input_size, hidden_size)
            ).astype(np.float32)
            * 0.08
        )

        self.b1 = np.zeros(
            hidden_size,
            dtype=np.float32
        )

        self.W2 = (
            rng.standard_normal(
                (hidden_size, output_size)
            ).astype(np.float32)
            * 0.08
        )

        self.b2 = np.zeros(
            output_size,
            dtype=np.float32
        )

        self.train()

    def build_vocabulary(self):

        vocabulary = set()

        for examples in self.training_data.values():

            for sentence in examples:

                for feature in make_features(sentence):

                    vocabulary.add(feature)

        return sorted(vocabulary)

    def vectorize(self, text):

        features = make_features(text)

        vector = np.zeros(
            len(self.vocabulary),
            dtype=np.float32
        )

        for feature in features:

            index = self.word_to_index.get(
                feature
            )

            if index is not None:

                vector[index] += 1.0

        if np.sum(vector) > 0:

            vector /= np.sum(vector)

        return vector

    def softmax(self, x):

        x = x - np.max(x)

        exp = np.exp(x)

        return exp / (
            np.sum(exp) + 1e-9
        )

    def relu(self, x):

        return np.maximum(
            0,
            x
        )

    def forward(self, x):

        z1 = (
            np.dot(
                x,
                self.W1
            )
            + self.b1
        )

        a1 = self.relu(
            z1
        )

        z2 = (
            np.dot(
                a1,
                self.W2
            )
            + self.b2
        )

        output = self.softmax(
            z2
        )

        return (
            z1,
            a1,
            output
        )

    def train(self):

        X = []
        Y = []

        for label, examples in self.training_data.items():

            target = self.label_to_number[
                label
            ]

            for sentence in examples:

                X.append(
                    self.vectorize(
                        sentence
                    )
                )

                Y.append(
                    target
                )

        X = np.array(
            X,
            dtype=np.float32
        )

        Y = np.array(
            Y,
            dtype=np.int32
        )

        learning_rate = 0.045

        epochs = 900

        for epoch in range(
            epochs
        ):

            indexes = np.random.permutation(
                len(X)
            )

            for index in indexes:

                x = X[index]

                target = Y[index]

                z1, a1, prediction = (
                    self.forward(x)
                )

                dz2 = prediction.copy()

                dz2[target] -= 1.0

                dW2 = np.outer(
                    a1,
                    dz2
                )

                db2 = dz2

                da1 = np.dot(
                    self.W2,
                    dz2
                )

                dz1 = (
                    da1
                    * (z1 > 0)
                )

                dW1 = np.outer(
                    x,
                    dz1
                )

                db1 = dz1

                self.W2 -= (
                    learning_rate
                    * dW2
                )

                self.b2 -= (
                    learning_rate
                    * db2
                )

                self.W1 -= (
                    learning_rate
                    * dW1
                )

                self.b1 -= (
                    learning_rate
                    * db1
                )

        print(
            f"🧠 Нейросеть обучена. "
            f"Интентов: {len(self.labels)}"
        )

        print(
            f"📚 Словарь: "
            f"{len(self.vocabulary)} признаков"
        )

    def predict(self, text):

        vector = self.vectorize(
            text
        )

        if np.sum(vector) <= 0:

            return None, 0.0

        _, _, probabilities = (
            self.forward(
                vector
            )
        )

        index = int(
            np.argmax(
                probabilities
            )
        )

        confidence = float(
            probabilities[index]
        )

        label = self.labels[
            index
        ]

        return (
            label,
            confidence
        )

    def answer(
        self,
        text,
        history=None
    ):

        intent, confidence = (
            self.predict(text)
        )

        print(
            f"🧠 Intent: {intent}"
        )

        print(
            f"📊 Уверенность: "
            f"{confidence:.2f}"
        )

        if (
            intent is None
            or confidence < CONFIDENCE_THRESHOLD
        ):

            return (
                "Я пока не уверен, "
                "что правильно понял тебя. "
                "Попробуй сформулировать немного иначе."
            )

        if intent == "time_question":

            now = datetime.datetime.now()

            return (
                f"Сейчас "
                f"{now.hour} часов "
                f"{now.minute} минут."
            )

        if intent == "date_question":

            today = datetime.datetime.now()

            months = [
                "января",
                "февраля",
                "марта",
                "апреля",
                "мая",
                "июня",
                "июля",
                "августа",
                "сентября",
                "октября",
                "ноября",
                "декабря"
            ]

            return (
                f"Сегодня "
                f"{today.day} "
                f"{months[today.month - 1]} "
                f"{today.year} года."
            )

        if intent == "current_day":

            days = [
                "понедельник",
                "вторник",
                "среда",
                "четверг",
                "пятница",
                "суббота",
                "воскресенье"
            ]

            today = datetime.datetime.now()

            return (
                f"Сегодня "
                f"{days[today.weekday()]}."
            )

        if intent == "goodbye":

            return "До встречи."

        if intent in self.responses:

            responses = (
                self.responses[
                    intent
                ]
            )

            return random.choice(
                responses
            )

        return (
            "Я понял тебя, "
            "но пока не знаю, "
            "что лучше ответить."
        )


# ============================================================
# JARVIS
# ============================================================

