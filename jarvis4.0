    # STEAM
    # ========================================================

    def open_steam(self):

        try:
            steam_path = os.path.expandvars(STEAM_EXE)

            if os.path.exists(steam_path):
                subprocess.Popen(
                    [steam_path],
                    shell=False
                )
            else:
                if not self.open_url("steam://open/main"):
                    self.speak(
                        "Не удалось запустить Steam."
                    )
                    return False

            self.speak(
                "Steam успешно запущен."
            )
            return True

        except Exception as error:
            print(
                f"❌ Ошибка Steam: {error}"
            )

            if self.open_url("steam://open/main"):
                self.speak(
                    "Steam успешно запущен."
                )
                return True

            self.speak(
                "Не удалось запустить Steam."
            )
            return False

