    def __init__(self):

        self.ai = MiniNeuralNetwork()

        self.recognizer = sr.Recognizer()

        print(
            "\n🔊 Загружаю голосовой движок..."
        )

        self.voice_rate = 175
        self.voice_volume = 1.0
        self.voice_id = None

        self._setup_voice()

        self.history = []

        self.conversation_mode = False

    # ========================================================
    # ГОВОРИМ
    # ========================================================

    def _setup_voice(self):

        try:
            test_engine = pyttsx3.init("sapi5")

            test_engine.setProperty(
                "rate",
                self.voice_rate
            )

            test_engine.setProperty(
                "volume",
                self.voice_volume
            )

            voices = test_engine.getProperty("voices") or []

            print(
                f"🔊 Найдено голосов Windows: {len(voices)}"
            )

            russian_voice = None

            for voice in voices:
                info = " ".join(
                    [
                        str(getattr(voice, "id", "")),
                        str(getattr(voice, "name", "")),
                        str(getattr(voice, "languages", "")),
                    ]
                ).lower()

                if (
                    "russian" in info
                    or "ru-ru" in info
                    or "ru_ru" in info
                    or "ru_" in info
                    or "рус" in info
                ):
                    russian_voice = voice
                    break

            if russian_voice is not None:
                self.voice_id = russian_voice.id

                print(
                    f"🇷🇺 Русский голос: "
                    f"{getattr(russian_voice, 'name', russian_voice.id)}"
                )

            elif voices:
                self.voice_id = voices[0].id

                print(
                    "⚠️ Русский голос не найден. "
                    f"Использую: {getattr(voices[0], 'name', voices[0].id)}"
                )

            else:
                self.voice_id = None
                print("❌ Windows не вернул список голосов.")

            try:
                test_engine.stop()
            except Exception:
                pass

            print("✅ Голосовой движок pyttsx3 готов.")
            return True

        except Exception as error:
            self.voice_id = None

            print(
                f"❌ Ошибка запуска pyttsx3/SAPI5: {error}"
            )

            return False

    def speak(self, text: str):

        text = str(text).strip()

        if not text:
            return False

        print(f"\n🤖 JARVIS: {text}")

        engine = None

        try:
            engine = pyttsx3.init("sapi5")

            engine.setProperty("rate", 175)
            engine.setProperty("volume", 1.0)

            voices = engine.getProperty("voices") or []

            selected_voice = None

            for voice in voices:
                voice_id = str(
                    getattr(voice, "id", "")
                ).lower()

                voice_name = str(
                    getattr(voice, "name", "")
                ).lower()

                voice_languages = str(
                    getattr(voice, "languages", "")
                ).lower()

                info = (
                    voice_id
                    + " "
                    + voice_name
                    + " "
                    + voice_languages
                )

                if (
                    "irina" in info
                    or "russian" in info
                    or "ru-ru" in info
                    or "ru_ru" in info
                    or "рус" in info
                ):
                    selected_voice = voice
                    break

            if selected_voice is not None:
                engine.setProperty(
                    "voice",
                    selected_voice.id
                )

                print(
                    "🔊 Голос: "
                    f"{getattr(selected_voice, 'name', selected_voice.id)}"
                )
            elif voices:
                engine.setProperty(
                    "voice",
                    voices[0].id
                )

                print(
                    "⚠️ Русский голос не найден. "
                    f"Использую: {getattr(voices[0], 'name', voices[0].id)}"
                )
            else:
                print("❌ Голоса SAPI5 не найдены.")
                return False

            print("🔊 Озвучиваю...")

            engine.say(text)
            engine.runAndWait()

            print("✅ Ответ озвучен.")
            return True

        except Exception as error:
            print(
                f"❌ Ошибка озвучки SAPI5: {error}"
            )
            return False

        finally:
            if engine is not None:
                try:
                    engine.stop()
                except Exception:
                    pass

    def test_voice(self):

        print("\n🔊 Проверка голоса JARVIS...")

        return self.speak(
            "Проверка. Я Джарвис. "
            "Теперь я должен озвучивать каждый свой ответ."
        )

    def remember(
        self,
        user_text,
        assistant_text
    ):

        self.history.append({

            "user": user_text,

            "assistant": assistant_text

        })

        if (
            len(self.history)
            > MAX_HISTORY
        ):

            self.history = (
                self.history[
                    -MAX_HISTORY:
                ]
            )

    def ask_ai(
        self,
        command
    ):

        try:

            answer = self.ai.answer(
                command,
                self.history
            )

            self.remember(
                command,
                answer
            )

            self.speak(
                answer
            )

        except Exception as error:

            print(
                f"❌ Ошибка нейросети: "
                f"{error}"
            )

            self.speak(
                "Произошла ошибка локальной нейросети."
            )

    # ========================================================
    # МИКРОФОН
    # ========================================================

    def show_microphone(self):

        print(
            "\n🎤 Проверяю микрофон..."
        )

        try:

            microphone = (
                sd.query_devices(
                    kind="input"
                )
            )

            print(
                f"Микрофон: "
                f"{microphone['name']}"
            )

            print(
                f"Каналов: "
                f"{microphone['max_input_channels']}"
            )

            return True

        except Exception as error:

            print(
                f"❌ Ошибка микрофона: "
                f"{error}"
            )

            return False

    # ========================================================
    # СЛУШАЕМ
    # ========================================================

    def listen(
        self,
        duration=None,
        check_speech=True,
        verbose=True
    ):

        if duration is None:
            duration = LISTEN_TIME

        if verbose:
            print(
                "\n🎙️ Я слушаю..."
            )
            print(
                f"Говори в течение "
                f"{duration} секунд..."
            )

        filename = None

        try:

            device = (
                sd.query_devices(
                    kind="input"
                )
            )

            channels = min(
                int(
                    device[
                        "max_input_channels"
                    ]
                ),
                1
            )

            if channels < 1:

                print(
                    "❌ Нет входного канала."
                )

                return ""

            recording = sd.rec(

                int(
                    duration
                    * SAMPLE_RATE
                ),

                samplerate=SAMPLE_RATE,

                channels=channels,

                dtype="int16"
            )

            sd.wait()

            if verbose:
                print(
                    "🔊 Запись закончена."
                )

            if check_speech:

                audio_float = (
                    recording.astype(
                        np.float32
                    )
                )

                rms = float(
                    np.sqrt(
                        np.mean(
                            audio_float ** 2
                        )
                    )
                )

                if rms < 150:

                    if verbose:
                        print(
                            "🔇 Тишина. "
                            "Пропускаю распознавание."
                        )

                    return ""

            if verbose:
                print(
                    "🧠 Распознаю речь..."
                )

            with tempfile.NamedTemporaryFile(
                suffix=".wav",
                delete=False
            ) as temp_file:

                filename = (
                    temp_file.name
                )

            wavfile.write(
                filename,
                SAMPLE_RATE,
                recording
            )

            with sr.AudioFile(
                filename
            ) as source:

                audio = (
                    self.recognizer.record(
                        source
                    )
                )

            text = (
                self.recognizer
                .recognize_google(
                    audio,
                    language="ru-RU"
                )
            )

            if verbose:
                print(
                    f"\n👤 Ты: {text}"
                )

            return normalize_text(
                text
            )

        except sr.UnknownValueError:

            if verbose:
                print(
                    "❓ Я не смог разобрать речь."
                )

            return ""

        except sr.RequestError as error:

            print(
                f"❌ Ошибка сервиса "
                f"распознавания: {error}"
            )

            return ""

        except Exception as error:

            print(
                f"❌ Ошибка микрофона: "
                f"{error}"
            )

            return ""

        finally:

            if (
                filename
                and os.path.exists(
                    filename
                )
            ):

                try:

                    os.remove(
                        filename
                    )

                except Exception:

                    pass

    # ========================================================
    # ЖДЁМ ОБРАЩЕНИЕ «ДЖАРВИС»
    # ========================================================

    def wait_for_wake_word(self):

        print(
            f"\n💤 Жду обращение «{JARVIS_NAME}»..."
        )

        while True:

            text = self.listen(
                duration=2,
                check_speech=True,
                verbose=False
            )

            if not text:

                continue

            if JARVIS_NAME in text:

                rest = (
                    text
                    .replace(
                        JARVIS_NAME,
                        "",
                        1
                    )
                    .strip()
                )

                print(
                    f"✅ Услышал обращение "
                    f"«{JARVIS_NAME}»."
                )

                return rest

    # ========================================================
    # РАБОТА С ОКНАМИ ПРИЛОЖЕНИЙ
    # ========================================================

    def _resolve_app_patterns(self, name):

        name = name.strip().lower()

        if not name:
            return []

        if name in self.APP_WINDOW_PATTERNS:
            return self.APP_WINDOW_PATTERNS[name]

        for key, patterns in self.APP_WINDOW_PATTERNS.items():

            if key in name or name in key:
                return patterns

        return [name]

    def _window_action(self, name, action):

        patterns = self._resolve_app_patterns(name)

        if not patterns:
            return False

        SW_MINIMIZE = 6
        SW_MAXIMIZE = 3
        SW_RESTORE = 9
        WM_CLOSE = 0x0010

        affected = 0

        for pattern in patterns:

            for hwnd in find_windows_by_title(pattern):

                try:

                    if action == "close":

                        ctypes.windll.user32.PostMessageW(
                            hwnd,
                            WM_CLOSE,
                            0,
                            0
                        )

                    elif action == "minimize":

                        ctypes.windll.user32.ShowWindow(
                            hwnd,
                            SW_MINIMIZE
                        )

                    elif action == "maximize":

                        ctypes.windll.user32.ShowWindow(
                            hwnd,
                            SW_MAXIMIZE
                        )

                    elif action == "restore":

                        ctypes.windll.user32.ShowWindow(
                            hwnd,
                            SW_RESTORE
                        )

                    affected += 1

                except Exception as error:

                    print(
                        f"❌ Ошибка действия "
                        f"{action}: {error}"
                    )

        return affected > 0

    def close_app(self, name):
        """
        Закрывает приложение.

        Сначала посылает окну WM_CLOSE (вежливое закрытие).
        Если через 1 секунду окно всё ещё существует —
        принудительно убивает процесс через taskkill
        (нужно для Dota 2 и подобных приложений,
        которые сворачиваются в трей вместо закрытия).
        """

        name = name.strip().lower()

        # Защита от закрытия самого Джарвиса
        if name in (
            "джарвис",
            "джарвиса",
            "программу",
            "программа",
            "себя",
            "работу"
        ):
            self.speak(
                "Скажи «выключись», чтобы я завершил работу."
            )
            return True

        # 1) Пробуем вежливое закрытие через WM_CLOSE
        ok = self._window_action(name, "close")

        if ok:

            # Ждём немного и проверяем — исчезло ли окно
            time.sleep(1)

            patterns = self._resolve_app_patterns(name)

            still_open = False

            for pattern in patterns:

                if find_windows_by_title(pattern):

                    still_open = True
                    break

            # Если окно всё ещё живо — закрываем жёстко
            if still_open:

                killed = self._force_kill_process(name)

                if killed:
                    self.speak(
                        f"Закрываю {name}."
                    )
                    return True

                self.speak(
                    f"Не удалось закрыть {name}."
                )
                return True

            self.speak(
                f"Закрываю {name}."
            )
            return True

        # 2) Окно не найдено через WM_CLOSE — пробуем сразу taskkill
        killed = self._force_kill_process(name)

        if killed:
            self.speak(
                f"Закрываю {name}."
            )
            return True

        self.speak(
            f"Не нашёл открытое окно {name}."
        )
        return True

    def _force_kill_process(self, name):
        """
        Принудительно убивает процессы приложения
        через taskkill /F /IM <process.exe>.

        Возвращает True, если хотя бы один процесс
        был успешно убит.
        """

        name = name.strip().lower()

        # Ищем имена процессов
        processes = None

        if name in self.APP_PROCESS_NAMES:

            processes = self.APP_PROCESS_NAMES[name]

        else:

            for key, value in self.APP_PROCESS_NAMES.items():

                if key in name or name in key:

                    processes = value
                    break

        if not processes:

            # Не знаем имя процесса — пробуем само слово + .exe
            processes = [f"{name}.exe"]

        killed_any = False

        # Проводник убивать нельзя — это рабочий стол.
        # Для него используем только вежливое закрытие окна.
        safe_skip = {"explorer.exe"}

        for process in processes:

            if process.lower() in safe_skip:
                continue

            try:

                result = subprocess.run(
                    ["taskkill", "/F", "/IM", process],
                    capture_output=True,
                    text=True,
                    creationflags=subprocess.CREATE_NO_WINDOW
                )

                if result.returncode == 0:

                    killed_any = True

                    print(
                        f"🔪 Убит процесс: {process}"
                    )

                else:

                    print(
                        f"ℹ️ Процесс не найден "
                        f"или уже закрыт: {process}"
                    )

            except Exception as error:

                print(
                    f"❌ Ошибка taskkill {process}: {error}"
                )

        return killed_any

    def minimize_app(self, name):

        ok = self._window_action(name, "minimize")

        if ok:
            self.speak(
                f"Сворачиваю {name}."
            )
        else:
            self.speak(
                f"Не нашёл открытое окно {name}."
            )

        return True

    def maximize_app(self, name):

        ok = self._window_action(name, "maximize")

        if ok:
            self.speak(
                f"Разворачиваю {name}."
            )
        else:
            self.speak(
                f"Не нашёл открытое окно {name}."
            )

        return True

    def hide_app(self, name):

        patterns = self._resolve_app_patterns(name)

        if not patterns:
            return False

        SW_HIDE = 0

        affected = 0

        for pattern in patterns:

            for hwnd in find_windows_by_title(pattern):

                try:

                    ctypes.windll.user32.ShowWindow(
                        hwnd,
                        SW_HIDE
                    )

                    affected += 1

                except Exception as error:

                    print(
                        f"❌ Ошибка скрытия: {error}"
                    )

        if affected > 0:
            self.speak(
                f"Скрываю {name} с экрана."
            )
        else:
            self.speak(
                f"Не нашёл открытое окно {name}."
            )

        return True

    def show_app(self, name):

        patterns = self._resolve_app_patterns(name)

        if not patterns:
            return False

        SW_SHOW = 5
        SW_RESTORE = 9

        affected = 0

        for pattern in patterns:

            for hwnd in find_windows_by_title(pattern):

                try:

                    ctypes.windll.user32.ShowWindow(
                        hwnd,
                        SW_SHOW
                    )

                    ctypes.windll.user32.ShowWindow(
                        hwnd,
                        SW_RESTORE
                    )

                    ctypes.windll.user32.SetForegroundWindow(
                        hwnd
                    )

                    affected += 1

                except Exception as error:

                    print(
                        f"❌ Ошибка показа окна: {error}"
                    )

        if affected > 0:
            self.speak(
                f"Показываю {name}."
            )
        else:
            self.speak(
                f"Не нашёл окно {name}. "
                f"Возможно, приложение не запущено."
            )

        return True

