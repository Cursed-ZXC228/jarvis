# ============================================================
# РАБОТА С ОКНАМИ WINDOWS
# ============================================================

def find_windows_by_title(substring):
    """
    Находит handle всех видимых окон, в заголовке
    которых встречается подстрока (без учёта регистра).
    """

    result = []

    substring_lower = substring.lower()

    EnumWindowsProc = ctypes.WINFUNCTYPE(
        ctypes.c_bool,
        ctypes.c_void_p,
        ctypes.c_void_p
    )

    def callback(hwnd, lparam):

        try:

            if not ctypes.windll.user32.IsWindowVisible(
                hwnd
            ):
                return True

            length = (
                ctypes.windll.user32
                .GetWindowTextLengthW(hwnd)
            )

            if length == 0:
                return True

            buf = ctypes.create_unicode_buffer(
                length + 1
            )

            ctypes.windll.user32.GetWindowTextW(
                hwnd,
                buf,
                length + 1
            )

            title = buf.value

            if substring_lower in title.lower():

                result.append(hwnd)

        except Exception:

            pass

        return True

    try:

        ctypes.windll.user32.EnumWindows(
            EnumWindowsProc(callback),
            0
        )

    except Exception as error:

        print(
            f"❌ Ошибка EnumWindows: {error}"
        )

    return result


# ============================================================
# УТИЛИТЫ
# ============================================================

def normalize_text(text):

    text = text.lower().strip()

    text = text.replace("ё", "е")

    text = re.sub(r"[^а-яa-z0-9\s]", " ", text)

    text = re.sub(r"\s+", " ", text)

    return text.strip()


def tokenize(text):

    text = normalize_text(text)

    return re.findall(
        r"[а-яa-z0-9]+",
        text
    )


def make_features(text):

    words = tokenize(text)

    features = list(words)

    for i in range(len(words) - 1):

        bigram = (
            words[i]
            + " "
            + words[i + 1]
        )

        features.append(bigram)

    return features


