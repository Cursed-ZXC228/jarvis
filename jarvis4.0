    # ========================================================
    # КАЛЬКУЛЯТОР
    # ========================================================

    def calculate(self, command):

        expression = command

        replacements = {

            "плюс": "+",
            "минус": "-",
            "умножить на": "*",
            "умножить": "*",
            "разделить на": "/",
            "разделить": "/",

            "x": "*",
            "икс": "*",

            "равно": ""
        }

        for word, symbol in (
            replacements.items()
        ):

            expression = expression.replace(
                word,
                symbol
            )

        expression = re.sub(
            r"[^0-9+\-*/(). ]",
            "",
            expression
        )

        expression = expression.strip()

        if not expression:

            self.speak(
                "Я не смог понять пример."
            )

            return False

        try:

            result = eval(
                expression,
                {
                    "__builtins__": {}
                },
                {}
            )

            self.speak(
                f"Результат — {result}."
            )

            return True

        except Exception:

            self.speak(
                "Я не смог вычислить этот пример."
            )

            return False

    # ========================================================
    # ПОГОДА
    # ========================================================

    def weather(self):

        url = (
            "https://www.google.com/search?q="
            + urllib.parse.quote("погода сегодня")
        )

        if self.open_url(url):

            self.speak(
                "Информация о погоде открыта."
            )

            return True

        self.speak(
            "Не удалось открыть информацию о погоде."
        )

        return False

    # ========================================================
    # ВЫПОЛНЕНИЕ КОМАНД
    # ========================================================

    def execute(self, command):

        if not command:

            return True

        command = normalize_text(command)

        # ====================================================
        # НАЧАЛО РАЗГОВОРА
        # ====================================================

        if (
            "давай поговорим"
            in command
            or
            "давай общаться"
            in command
            or
            "поговори со мной"
            in command
            or
            "начни разговор"
            in command
            or
            "хочу поговорить"
            in command
        ):

            self.conversation_mode = True

            self.speak(
                "Конечно. Я готов поговорить. "
                "Теперь можешь говорить без слова Джарвис."
            )

            return True

        # ====================================================
        # КОНЕЦ РАЗГОВОРА
        # ====================================================

        if (
            self.conversation_mode
            and
            (
                "закончи разговор"
                in command
                or
                "заверши разговор"
                in command
                or
                "хватит разговора"
                in command
                or
                command in [
                    "все",
                    "до свидания",
                    "пока"
                ]
            )
        ):

            self.conversation_mode = False

            self.speak(
                "Хорошо. Режим разговора завершён."
            )

            return True

        # ====================================================
        # ЗАВЕРШЕНИЕ РАБОТЫ JARVIS
        # ====================================================

        shutdown_phrases = [
            "выключись",
            "выключи себя",
            "выключи джарвиса",
            "заверши работу",
            "заверши программу",
            "завершение работы",
            "завершение работ",
            "завершении работы",
            "завершении работ",
            "закончи работу",
            "закончить работу",
            "закройся",
            "закрой джарвиса",
            "закрой программу",
            "останови работу",
            "останови джарвиса"
        ]

        if any(
            phrase in command
            for phrase in shutdown_phrases
        ):
            self.speak(
                "Завершаю работу программы. До встречи."
            )
            return False

        if (
            "заверш" in command
            and "работ" in command
        ):
            self.speak(
                "Завершаю работу программы. До встречи."
            )
            return False

        predicted_intent, predicted_confidence = self.ai.predict(command)

        if (
            predicted_intent == "shutdown"
            and predicted_confidence >= CONFIDENCE_THRESHOLD
        ):
            self.speak(
                "Завершаю работу программы. До встречи."
            )
            return False

        # ====================================================
        # ЗАКРЫТИЕ ПРИЛОЖЕНИЙ
        # ====================================================

        if command.startswith("закрой "):

            target = command[
                len("закрой "):
            ].strip()

            if target.startswith("приложение "):

                target = target[
                    len("приложение "):
                ].strip()

            if target and target not in (
                "джарвис",
                "джарвиса",
                "программу",
                "программа",
                "себя",
                "работу"
            ):

                self.close_app(target)
                return True

        if command.startswith("закрыть "):

            target = command[
                len("закрыть "):
            ].strip()

            if target.startswith("приложение "):

                target = target[
                    len("приложение "):
                ].strip()

            if target and target not in (
                "джарвис",
                "джарвиса",
                "программу",
                "программа",
                "себя",
                "работу"
            ):

                self.close_app(target)
                return True

        # ====================================================
        # СВЁРТЫВАНИЕ ПРИЛОЖЕНИЙ
        # ====================================================

        minimize_prefixes = [
            "сверни ",
            "свернуть ",
            "минимизируй ",
            "минимизировать "
        ]

        for prefix in minimize_prefixes:

            if command.startswith(prefix):

                target = command[
                    len(prefix):
                ].strip()

                if target.startswith("приложение "):

                    target = target[
                        len("приложение "):
                    ].strip()

                if target:

                    self.minimize_app(target)
                    return True

        # ====================================================
        # РАЗВОРАЧИВАНИЕ ПРИЛОЖЕНИЙ
        # ====================================================

        maximize_prefixes = [
            "разверни ",
            "развернуть ",
            "максимизируй ",
            "максимизировать "
        ]

        for prefix in maximize_prefixes:

            if command.startswith(prefix):

                target = command[
                    len(prefix):
                ].strip()

                if target.startswith("приложение "):

                    target = target[
                        len("приложение "):
                    ].strip()

                if target:

                    self.maximize_app(target)
                    return True

        # ====================================================
        # СКРЫТИЕ ПРИЛОЖЕНИЙ
        # ====================================================

        hide_prefixes = [
            "скрой ",
            "скрыть ",
            "спрячь ",
            "спрятать "
        ]

        for prefix in hide_prefixes:

            if command.startswith(prefix):

                target = command[
                    len(prefix):
                ].strip()

                if target.startswith("приложение "):

                    target = target[
                        len("приложение "):
                    ].strip()

                if target:

                    self.hide_app(target)
                    return True

        # ====================================================
        # ВОЗВРАТ НА ЭКРАН
        # ====================================================

        show_prefixes = [
            "покажи ",
            "верни ",
            "восстанови ",
            "отобрази "
        ]

        for prefix in show_prefixes:

            if command.startswith(prefix):

                target = command[
                    len(prefix):
                ].strip()

                if target.startswith("приложение "):

                    target = target[
                        len("приложение "):
                    ].strip()

                if target:

                    self.show_app(target)
                    return True

        # ====================================================
        # ВРЕМЯ
        # ====================================================

        if (
            "который час"
            in command
            or
            "сколько времени"
            in command
            or
            command == "время"
        ):

            now = datetime.datetime.now()

            self.speak(
                f"Сейчас "
                f"{now.hour} часов "
                f"{now.minute} минут."
            )

            return True

        # ====================================================
        # ДАТА
        # ====================================================

        if (
            "какая сегодня дата"
            in command
            or
            "какое сегодня число"
            in command
        ):

            today = datetime.datetime.now()

            months = [
                "января",
                "февраля",
                "марта",
                "апреля",
                "мая",
                "июня",
                "июля",
                "августа",
                "сентября",
                "октября",
                "ноября",
                "декабря"
            ]

            self.speak(
                f"Сегодня "
                f"{today.day} "
                f"{months[today.month - 1]} "
                f"{today.year} года."
            )

            return True

        # ====================================================
        # ДЕНЬ НЕДЕЛИ
        # ====================================================

        if (
            "день недели"
            in command
            or
            "какой сегодня день"
            in command
        ):

            days = [
                "понедельник",
                "вторник",
                "среда",
                "четверг",
                "пятница",
                "суббота",
                "воскресенье"
            ]

            day = datetime.datetime.now().weekday()

            self.speak(
                f"Сегодня {days[day]}."
            )

            return True

        # ====================================================
        # БЛОКНОТ
        # ====================================================

        if "блокнот" in command:

            try:

                subprocess.Popen("notepad.exe")

                self.speak(
                    "Блокнот успешно запущен."
                )

            except Exception as error:

                self.speak(
                    "Не удалось запустить блокнот."
                )

                print(f"❌ Ошибка блокнота: {error}")

            return True

        # ====================================================
        # КАЛЬКУЛЯТОР
        # ====================================================

        if "калькулятор" in command:

            try:

                subprocess.Popen("calc.exe")

                self.speak(
                    "Калькулятор успешно запущен."
                )

            except Exception as error:

                self.speak(
                    "Не удалось запустить калькулятор."
                )

                print(f"❌ Ошибка калькулятора: {error}")

            return True

        # ====================================================
        # ПРОВОДНИК
        # ====================================================

        if (
            "открой проводник"
            in command
            or
            "запусти проводник"
            in command
            or
            "открой файлы"
            in command
            or
            "открой папки"
            in command
        ):

            try:

                subprocess.Popen("explorer.exe")

                self.speak(
                    "Проводник успешно запущен."
                )

            except Exception as error:

                self.speak(
                    "Не удалось запустить проводник."
                )

                print(f"❌ Ошибка проводника: {error}")

            return True

        # ====================================================
        # ЗАГРУЗКИ
        # ====================================================

        if (
            "открой загрузки"
            in command
            or
            "покажи загрузки"
            in command
            or
            "открой папку загрузки"
            in command
        ):

            downloads = os.path.join(
                os.path.expanduser("~"),
                "Downloads"
            )

            try:

                os.startfile(downloads)

                self.speak(
                    "Папка загрузок успешно открыта."
                )

            except Exception as error:

                self.speak(
                    "Не удалось открыть папку загрузок."
                )

                print(f"❌ Ошибка загрузок: {error}")

            return True

        # ====================================================
        # ДИСПЕТЧЕР ЗАДАЧ
        # ====================================================

        if (
            "диспетчер задач"
            in command
            or
            "task manager"
            in command
        ):

            try:

                subprocess.Popen("taskmgr.exe")

                self.speak(
                    "Диспетчер задач успешно запущен."
                )

            except Exception as error:

                self.speak(
                    "Не удалось запустить диспетчер задач."
                )

                print(f"❌ Ошибка диспетчера задач: {error}")

            return True

        # ====================================================
        # CMD
        # ====================================================

        if (
            "командную строку"
            in command
            or
            command == "открой cmd"
            or
            command == "запусти cmd"
            or
            "открой консоль"
            in command
        ):

            try:

                subprocess.Popen("cmd.exe")

                self.speak(
                    "Командная строка успешно запущена."
                )

            except Exception as error:

                self.speak(
                    "Не удалось запустить командную строку."
                )

                print(f"❌ Ошибка CMD: {error}")

            return True

        # ====================================================
        # НАСТРОЙКИ
        # ====================================================

        if (
            "открой настройки"
            in command
            or
            "запусти настройки"
            in command
            or
            "покажи настройки"
            in command
        ):

            try:

                subprocess.Popen(
                    "start ms-settings:",
                    shell=True
                )

                self.speak(
                    "Настройки Windows успешно открыты."
                )

            except Exception as error:

                self.speak(
                    "Не удалось открыть настройки Windows."
                )

                print(f"❌ Ошибка настроек: {error}")

            return True

        # ====================================================
        # STEAM
        # ====================================================

        if (
            "открой стим" in command
            or
            "запусти стим" in command
            or
            "открой steam" in command
            or
            "запусти steam" in command
            or
            command == "steam"
        ):
            self.open_steam()
            return True

        # ====================================================
        # DOTA 2
        # ====================================================

        if (
            "открой доту" in command
            or
            "запусти доту" in command
            or
            "открой dota" in command
            or
            "запусти dota" in command
            or
            "запусти dota 2" in command
            or
            command == "дота 2"
            or
            command == "dota 2"
        ):
            self.open_dota2()
            return True

        # ====================================================
        # DISCORD
        # ====================================================

        if (
            "открой дискорд" in command
            or
            "запусти дискорд" in command
            or
            "открой discord" in command
            or
            "запусти discord" in command
            or
            command == "discord"
        ):
            self.open_discord()
            return True

        # ====================================================
        # ЯНДЕКС МУЗЫКА
        # ====================================================

        yandex_music_indicators = [
            "яндекс музыка",
            "яндекс музыку",
            "яндекс музыке",
            "яндекс мьюзик",
            "я музыка",
            "я музыку",
            "я музыке"
        ]

        yandex_music_service_words = [
            "блокнот",
            "калькулятор",
            "проводник",
            "браузер",
            "интернет",
            "гугл",
            "google",
            "стим",
            "steam",
            "доту",
            "dota",
            "дискорд",
            "discord",
            "настройк",
            "консоль",
            "cmd",
            "командн",
            "загрузк",
            "диспетчер"
        ]

        if any(
            indicator in command
            for indicator in yandex_music_indicators
        ):

            query = self.extract_yandex_music_query(
                command
            )

            if query:

                self.yandex_music_search(query)

            else:

                self.open_yandex_music()

            return True

        if command.startswith("включи "):

            rest = command[
                len("включи "):
            ].strip()

            if (
                "ютуб" in command
                or
                "youtube" in command
                or
                rest == "видео"
            ):

                pass

            elif rest in (
                "музыку",
                "музыка",
                "музыки"
            ):

                self.open_yandex_music()
                return True

            elif (
                rest
                and not any(
                    sw in command
                    for sw in yandex_music_service_words
                )
            ):

                self.yandex_music_search(rest)
                return True

        # ====================================================
        # БРАУЗЕР
        # ====================================================

        if (
            "открой браузер"
            in command
            or
            "открой интернет"
            in command
            or
            "открой google"
            in command
            or
            "открой гугл"
            in command
        ):

            if self.open_url(
                "https://www.google.com"
            ):

                self.speak(
                    "Браузер успешно открыт."
                )

            else:

                self.speak(
                    "Не удалось открыть браузер."
                )

            return True

        # ====================================================
        # YOUTUBE
        # ====================================================

        if (
            "открой ютуб"
            in command
            or
            "открой youtube"
            in command
            or
            "запусти ютуб"
            in command
        ):

            if self.open_url(
                "https://www.youtube.com"
            ):

                self.speak(
                    "YouTube успешно открыт."
                )

            else:

                self.speak(
                    "Не удалось открыть YouTube."
                )

            return True

        # ====================================================
        # ПОГОДА
        # ====================================================

        if (
            "какая погода"
            in command
            or
            "погода сегодня"
            in command
            or
            "что с погодой"
            in command
        ):

            self.weather()

            return True

        # ====================================================
        # GOOGLE ПОИСК
        # ====================================================

        search_prefixes = [
            "найди ",
            "поищи ",
            "загугли ",
            "найди в интернете ",
            "поищи в интернете "
        ]

        if any(
            command.startswith(prefix)
            for prefix in search_prefixes
        ):

            query = self.extract_search_query(command)

            self.google_search(query)

            return True

        # ====================================================
        # YOUTUBE ПОИСК
        # ====================================================

        youtube_prefixes = [
            "включи ",
            "найди видео ",
            "найди музыку ",
            "найди на ютубе ",
            "поищи на ютубе ",
            "поищи видео на ютубе ",
            "поищи музыку на ютубе "
        ]

        if any(
            command.startswith(prefix)
            for prefix in youtube_prefixes
        ):

            query = self.extract_youtube_query(command)

            self.youtube_search(query)

            return True

        # ====================================================
        # ПРИВЕТСТВИЕ
        # ====================================================

        if any(
            word in command
            for word in [
                "привет",
                "здравствуй",
                "добрый день",
                "доброе утро",
                "добрый вечер"
            ]
        ):

            self.speak(
                "Приветствую. Я готов к работе."
            )

            return True

        # ====================================================
        # КТО ТЫ
        # ====================================================

        if (
            "кто ты"
            in command
            or
            "как тебя зовут"
            in command
        ):

            self.speak(
                "Я Джарвис, локальный "
                "голосовой помощник с "
                "небольшой нейросетью."
            )

            return True

        # ====================================================
        # ПОСЧИТАТЬ
        # ====================================================

        if (
            command.startswith("посчитай")
            or
            command.startswith("вычисли")
            or
            "сколько будет"
            in command
        ):

            self.calculate(command)

            return True

        # ====================================================
        # НЕЙРОСЕТЬ
        # ====================================================

        self.ask_ai(command)

        return True

    # ========================================================
    # ЗАПУСК
    # ========================================================

    def run(self):

        voice_ok = self.test_voice()

        if not voice_ok:
            print(
                "⚠️ JARVIS продолжит работу, "
                "но голос может быть недоступен."
            )
        else:
            print("✅ Голосовая система готова.")
            self.speak(
                "Голосовая система работает нормально."
            )

        if not self.show_microphone():

            self.speak(
                "Я не вижу микрофон."
            )

            return

        self.speak(
            "Система запущена. "
            "Улучшенная локальная нейросеть готова."
        )

        self.speak(
            f"Скажи «{JARVIS_NAME}», "
            f"чтобы я начал слушать."
        )

        while True:

            if self.conversation_mode:

                print(
                    "\n💬 Режим разговора активен."
                )

                command = self.listen()

            else:

                wake_rest = self.wait_for_wake_word()

                if wake_rest:

                    command = wake_rest

                else:

                    self.speak(
                        "Да, я слушаю."
                    )

                    command = self.listen()

            if not command:

                continue

            if not self.execute(command):

                break


# ============================================================
# MAIN
# ============================================================

if __name__ == "__main__":

    try:

        jarvis = Jarvis()

        jarvis.run()

    except KeyboardInterrupt:

        print(
            "\n\n🛑 JARVIS остановлен."
        )

    except Exception as error:

        print(
            "\n❌ Критическая ошибка:"
        )

        print(
            error
        )
