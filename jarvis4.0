                subprocess.Popen(
                    [music_path],
                    shell=False
                )
                self.speak(
                    "Яндекс Музыка запущена."
                )
                return True

            try:
                os.startfile("yandexmusic://")
                self.speak(
                    "Яндекс Музыка запущена."
                )
                return True

            except Exception as deep_error:
                print(
                    f"❌ Deep-link yandexmusic:// "
                    f"не сработал: {deep_error}"
                )

            self.speak(
                "Не удалось запустить Яндекс Музыку. "
                "Проверь путь к приложению."
            )
            return False

        except Exception as error:
            print(
                f"❌ Ошибка Яндекс Музыки: {error}"
            )

            self.speak(
                "Не удалось запустить Яндекс Музыку."
            )
            return False

    def yandex_music_search(self, query):

        query = query.strip()

        if not query:

            return self.open_yandex_music()

        music_path = os.path.expandvars(YANDEX_MUSIC_EXE)

        if os.path.exists(music_path):

            try:

                subprocess.Popen(
                    [music_path],
                    shell=False
                )

                time.sleep(2)

            except Exception as error:

                print(
                    f"❌ Не удалось запустить "
                    f"Яндекс Музыку: {error}"
                )

        encoded = urllib.parse.quote(query)

        deep_links = [

            f"yandexmusic://search?text={encoded}",

            f"yandexmusic://search/{encoded}"

        ]

        for url in deep_links:

            try:

                os.startfile(url)

                self.speak(
                    f"Включаю {query} в Яндекс Музыке."
                )
                return True

            except Exception as error:

                print(
                    f"❌ Deep-link {url} "
                    f"не сработал: {error}"
                )

        self.speak(
            f"Яндекс Музыка открыта. "
            f"Похоже, приложение не принимает "
            f"поисковый запрос автоматически — "
            f"найди {query} вручную."
        )
        return True

    def extract_yandex_music_query(self, command):

        prefixes = [
            "включи в яндекс музыке ",
            "включи в яндекс музыка ",
            "включи в яндекс мьюзик ",
            "включи в я музыке ",
            "найди в яндекс музыке ",
            "найди в яндекс музыка ",
            "найди в яндекс мьюзик ",
            "поищи в яндекс музыке ",
            "поищи в яндекс музыка ",
            "включи песню в яндекс музыке ",
            "включи трек в яндекс музыке ",
            "включи песню ",
            "включи трек ",
            "включи "
        ]

        for prefix in prefixes:

            if command.startswith(
                prefix
            ):

                return (
                    command[
                        len(prefix):
                    ].strip()
                )

        return ""

